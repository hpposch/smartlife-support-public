# PostgreSQL
DATABASE_URL="postgresql://smartlife:smartlife@localhost:5432/smartlife_support"

# Redis (BullMQ-Queues)
REDIS_URL="redis://localhost:6379"

# Session-Verschlüsselung — mindestens 32 Zeichen, z. B. `openssl rand -hex 32`
SESSION_SECRET="change-me-change-me-change-me-change-me"

# Basis-URL der App (für Links in E-Mails)
APP_URL="http://localhost:3000"

# Ablage für Anhänge und Roh-E-Mails (Volume in Docker)
DATA_DIR="./data"

# Initialer Admin (wird vom Seed angelegt)
SEED_ADMIN_EMAIL="admin@smartlife.software"
SEED_ADMIN_PASSWORD="admin1234"

# API-Key für POST /api/v1/tickets (leer = API deaktiviert)
API_KEY=""

# Backups: Zielverzeichnis, Zeitplan (Cron, Worker-Prozess) und Aufbewahrung
BACKUP_DIR="./backups"
BACKUP_CRON="0 3 * * *"
BACKUP_KEEP_DAYS="30"

# Zufriedenheitsumfrage nach Lösung eines Tickets (Bewertungslink per E-Mail)
CSAT_ENABLED="false"

# KI-Unterstützung: Antwortentwürfe, Zusammenfassungen, Auto-Klassifizierung,
# Chat-Assistent. Nichts gesetzt = KI-Funktionen ausgeblendet.
#
# Variante A — Claude API (Standard). API-Key: https://platform.claude.com
ANTHROPIC_API_KEY=""
# Modell (Standard: claude-opus-4-8)
# AI_MODEL="claude-opus-4-8"
#
# Variante B — beliebige OpenAI-kompatible API (OpenAI, Azure OpenAI,
# OpenRouter, LiteLLM, Ollama, vLLM …): URL, Key und Modell angeben.
# AI_PROVIDER ist optional — bei gesetzter AI_BASE_URL wird "openai"
# automatisch gewählt. Für lokale Server ohne Authentifizierung einen
# beliebigen Wert als AI_API_KEY eintragen (z. B. "none").
# AI_PROVIDER="openai"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""
# AI_MODEL="gpt-4o"
#
# Auto-Klassifizierung neuer Tickets abschalten (Standard: an, wenn KI aktiv)
# AI_AUTO_CLASSIFY="false"

# Azure AD B2C — Kundenlogin fürs Portal (leer = Magic-Link-Login per E-Mail).
# App-Registrierung (Typ Web) im B2C-Tenant anlegen mit Redirect-URI:
#   {APP_URL}/portal/auth/b2c/callback
# Im User-Flow "Email Addresses" + "Display Name" als Anwendungsansprüche aktivieren.
AZURE_B2C_TENANT=""          # Tenant-Name, z. B. "smartlifekunden"
AZURE_B2C_POLICY=""          # User-Flow, z. B. "B2C_1_signin"
AZURE_B2C_CLIENT_ID=""
AZURE_B2C_CLIENT_SECRET=""
# Optional: Authority-URL überschreiben (Custom Domain), sonst aus Tenant+Policy gebildet
# AZURE_B2C_AUTHORITY="https://login.smartlife.software/<tenant>.onmicrosoft.com/<policy>/v2.0"
# Optional: Magic-Link zusätzlich zu B2C anbieten (Standard: nur B2C, wenn konfiguriert)
# PORTAL_MAGIC_LINK="true"

# Postfach-Passwörter: Der Wert von `credentialsRef` einer Mailbox in der DB
# benennt die ENV-Variable, die das Passwort enthält, z. B.:
# MAILBOX_SUPPORT_PASSWORD="..."

# --- Semantische KB-Suche (nur mit OpenAI-kompatiblem Provider) ---
# Embedding-Modell (Standard: text-embedding-3-small); AI_EMBEDDINGS=false schaltet ab
# AI_EMBEDDING_MODEL="text-embedding-3-small"
# AI_EMBEDDINGS="false"

# --- DSGVO-Aufbewahrung: Inhalte geschlossener Tickets nach X Tagen schwärzen ---
# RETENTION_ANONYMIZE_DAYS="1095"

# --- Betriebs-Alerts: Mail, wenn der Postfach-Abruf steht (leer = aus) ---
# ALERT_EMAIL="office@smartlife.software"

# --- WhatsApp Business (Cloud API) ---
# WHATSAPP_TOKEN=""              # Permanent-Token der Meta-App
# WHATSAPP_PHONE_NUMBER_ID=""    # Phone Number ID der Business-Nummer
# WHATSAPP_VERIFY_TOKEN=""       # frei gewählt; im Meta-Webhook-Setup eintragen
# WHATSAPP_PRODUCT=""            # Produkt-Kürzel (leer = Standard-Produkt)

# --- Backup-Upload zu S3-kompatiblem Speicher (AWS, MinIO, Backblaze, Hetzner …) ---
# S3_BACKUP_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""                 # leer = AWS; sonst z. B. https://s3.hetzner.cloud
# S3_REGION="eu-central-1"
# S3_PREFIX="smartlife-support"

# --- Eigener OIDC-Login pro Produkt: Secret-ENV-Referenzen (Verwaltung → Produkte) ---
# OIDC_PLANTBEAT_SECRET=""
